/* ==================== 页面基础布局 ==================== */

/* 轮播图区域 */
.section {
  margin-bottom: 24rpx;
}

.banner-section {
  margin-bottom: 24rpx;
}

.banner-swiper {
  width: 100%;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}

.banner-item {
  width: 100%;
  height: 100%;
}

.banner-card {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.swiper-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--text-placeholder);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.dot.active {
  width: 32rpx;
  background-color: var(--primary-color);
  border-radius: 6rpx;
}

/* 页面容器 - 占满整个视口高度 */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 0;
}

/* 滚动区域 - 可滚动内容区 */
.scroll-container {
  flex: 1;
  height: 0;
  width: 100%;
}

/* 内容区域 - 卡片容器的外边距 */
.content {
  box-sizing: border-box;
  width: 100%;
  padding: 40rpx;  /* 四周内边距，可调整 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom) + 40rpx);
}

/* ==================== 卡片行布局 ==================== */

/* 双列卡片行 - 包含投诉和协商函两个卡片 */
.card-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;           /* 两个卡片之间的间隙，可调整 */
  margin-bottom: 24rpx; /* 与下方大卡片的间距，可调整 */
}

/* ==================== 基础卡片样式 ==================== */

/* 卡片基础样式 - 所有卡片共用 */
.card {
  box-sizing: border-box;
  position: relative;
  border-radius: 48rpx;  /* 卡片圆角，可调整（当前48rpx） */
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx -8rpx rgba(0, 0, 0, 0.15);  /* 阴影效果 */
  transform: translateZ(0);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  margin-bottom: 0;  /* 覆盖全局样式 */
}

/* 卡片点击效果 */
.card:active {
  transform: scale(0.98);
}

/* ==================== 小卡片样式（投诉、协商函） ==================== */

/* 小卡片 - 正方形，宽度占50% */
.card-small {
  width: calc(50% - 12rpx);  /* 减去间隙的一半 */
  aspect-ratio: 1;           /* 保持正方形比例 */
  flex: 1;
}

/* 小卡片内容区域 */
.card-small .card-content {
  position: relative;
  z-index: 10;
  height: 100%;
  padding: 32rpx;  /* 内边距，可调整（当前32rpx） */
  display: flex;
  flex-direction: column;
  justify-content: flex-start;  /* 内容从顶部开始排列 */
  box-sizing: border-box;
}

/* 小卡片标题样式 */
.card-small .card-title {
  display: block;
  font-size: 32rpx;     /* 标题字号，可调整（当前32rpx） */
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx; /* 标题与描述的间距，可调整 */
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 0;
  line-height: 1.2;
  white-space: nowrap;      /* 不换行 */
  overflow: hidden;         /* 超出隐藏 */
  text-overflow: ellipsis;  /* 超出显示省略号 */
}

/* 小卡片描述文字样式 */
.card-small .card-desc {
  display: block;
  font-size: 22rpx;     /* 描述字号，可调整（当前22rpx） */
  font-weight: 500;
  opacity: 0.95;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;  /* 最多显示2行 */
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 小卡片信息区域 */
.card-small .card-info {
  margin-top: auto;  /* 自动推到底部 */
}

/* ==================== 大卡片样式（民事起诉状） ==================== */

/* 大卡片 - 横向矩形 */
.card-large {
  width: 100%;
  height: 320rpx;  /* 卡片高度，可调整（当前320rpx） */
}

/* 大卡片内容区域 */
.card-large .card-content {
  position: relative;
  z-index: 10;
  height: 100%;
  padding: 32rpx;  /* 与小卡片一致，32rpx */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 大卡片箭头图标 - 绝对定位在右上角 */
.card-large .arrow-icon {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 40rpx;
  height: 40rpx;
  opacity: 0.9;
}

/* 大卡片标题样式 */
.card-large .card-title {
  display: block;
  font-size: 32rpx;     /* 标题字号，可调整（当前32rpx） */
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx; /* 标题与描述的间距，可调整 */
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 0;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 大卡片描述文字样式 */
.card-large .card-desc {
  display: block;
  font-size: 22rpx;     /* 描述字号，可调整（当前22rpx） */
  font-weight: 500;
  opacity: 0.95;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 大卡片信息区域 */
.card-large .card-info {
  margin-top: auto;
  padding-bottom: 4rpx;
}

/* ==================== 背景图层 ==================== */

/* 背景容器 */
.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 背景图片 */
.card-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.4;           /* 透明度，可调整（当前0.4，范围0-1） */
  mix-blend-mode: overlay;  /* 混合模式 */
}

/* 背景渐变层 */
.card-bg-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ==================== 卡片主题色 ==================== */

/* 民事起诉状 - 绿色渐变 */
.card-civil {
  background: linear-gradient(135deg, #065f46 0%, #047857 100%);
}
.card-civil .card-bg-gradient {
  background: linear-gradient(135deg, rgba(6, 95, 70, 0.9) 0%, rgba(4, 120, 87, 0.85) 100%);
}
.card-civil .card-desc {
  color: #d1fae5;
}

/* 投诉文本 - 蓝色渐变 */
.card-complaint {
  background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
}
.card-complaint .card-bg-gradient {
  background: linear-gradient(135deg, rgba(30, 58, 138, 0.9) 0%, rgba(37, 99, 235, 0.85) 100%);
}
.card-complaint .card-desc {
  color: #dbeafe;
}

/* 协商函 - 棕色渐变 */
.card-negotiation {
  background: linear-gradient(135deg, #78350f 0%, #92400e 100%);
}
.card-negotiation .card-bg-gradient {
  background: linear-gradient(135deg, rgba(120, 53, 15, 0.9) 0%, rgba(146, 64, 14, 0.85) 100%);
}
.card-negotiation .card-desc {
  color: #ffedd5;
}

/* ==================== 图标样式 ==================== */

/* 玻璃拟态图标 - 所有卡片共用 */
.glass-icon {
  width: 80rpx;         /* 图标宽度，可调整（当前80rpx） */
  height: 80rpx;        /* 图标高度，可调整（当前80rpx） */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx; /* 图标圆角，可调整（当前24rpx） */
  background: rgba(255, 255, 255, 0.2);  /* 背景透明度 */
  backdrop-filter: blur(8px);            /* 毛玻璃效果 */
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.3);  /* 边框 */
  margin-bottom: 40rpx;  /* 图标与标题的间距，可调整（当前40rpx） */
}

/* 小卡片图标 - 正方形 80x80 */
.card-small .glass-icon {
  width: 80rpx !important;   /* 强制宽度80rpx */
  height: 80rpx !important;  /* 强制高度80rpx，与宽度相等形成正方形 */
  min-width: 80rpx !important;   /* 防止被压缩 */
  min-height: 80rpx !important;  /* 防止被压缩 */
  flex-shrink: 0 !important;     /* 防止flex布局压缩 */
  border-radius: 24rpx;      /* 圆角恢复为24rpx */
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

/* 大卡片图标 - 正方形 80x80 */
.card-large .glass-icon {
  width: 80rpx !important;   /* 强制宽度80rpx */
  height: 80rpx !important;  /* 强制高度80rpx，与宽度相等形成正方形 */
  min-width: 80rpx !important;   /* 防止被压缩 */
  min-height: 80rpx !important;  /* 防止被压缩 */
  flex-shrink: 0 !important;     /* 防止flex布局压缩 */
  border-radius: 24rpx;      /* 圆角恢复为24rpx */
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

/* 图标图片 - 小卡片 */
.card-icon {
  width: 36rpx;   /* 图标内部图片宽度 */
  height: 36rpx;  /* 图标内部图片高度 */
  filter: brightness(0) invert(1);  /* 变为白色 */
}

/* 图标图片 - 大卡片 */
.card-large .card-icon {
  width: 38rpx;
  height: 38rpx;
}

/* 箭头图标 */
.arrow-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.8;
  filter: brightness(0) invert(1);
}

/* ==================== 底部提示 ==================== */

/* 底部提示容器 */
.bottom-notice {
  margin-top: 32rpx;
  padding: 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* 提示图标 */
.notice-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.4;
  margin-top: 2rpx;
}

/* 提示文字 */
.notice-text {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 400;
  line-height: 1.6;
}

/* ==================== 暗黑模式适配 ==================== */

@media (prefers-color-scheme: dark) {
  .bottom-notice {
    background: rgba(31, 41, 55, 0.5);
    border-color: rgba(255, 255, 255, 0.05);
  }
  .notice-text {
    color: #9ca3af;
  }
  .notice-icon {
    opacity: 0.6;
    filter: brightness(0) invert(1);
  }
}
