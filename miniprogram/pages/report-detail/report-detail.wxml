<view class="container">
  <sub-header title="举报文书详情" back="{{true}}"></sub-header>

  <view class="content-wrapper" wx:if="{{!isEditing}}">
    <view class="doc-title">{{document.formData.documentType === 'online' ? '举报文本' : '举报信'}}</view>

    <text class="detail-text-view" user-select="{{true}}">{{mainContent}}</text>

    <view class="signature-block" wx:if="{{document.formData.documentType !== 'online'}}">
      <text class="signature-line" user-select="{{true}}">举报人：___________</text>
      <text class="date-line" user-select="{{true}}">{{dateStr}}</text>
    </view>

    <view class="bottom-warning">
        <text>本工具为辅助生成，生成的文书仅供参考，不构成正式法律意见。正式使用前，建议根据自身情况咨询专业律师。建议用户在正式提交前请专业人士复核。</text>
    </view>
  </view>

  <view class="edit-wrapper" wx:if="{{isEditing}}">
    <editor
      id="editor"
      class="full-screen-editor"
      placeholder="请输入内容"
      bindready="onEditorReady"
      bindinput="onEditorInput"
      show-img-size="{{false}}"
      show-img-toolbar="{{false}}"
      show-img-resize="{{false}}"
    />
  </view>

  <view class="floating-buttons" wx:if="{{!isEditing}}">
    <view class="fab-btn copy-btn" bindtap="copyText">
      <image class="fab-icon" src="/images/icons/copy.svg" mode="aspectFit"></image>
    </view>
    <view class="fab-btn edit-btn" bindtap="startEditing">
      <image class="fab-icon" src="/images/icons/edit.svg" mode="aspectFit"></image>
    </view>
  </view>

  <view class="editor-toolbar" wx:if="{{isEditing}}">
    <view class="toolbar-btn save-btn" bindtap="saveEditing">
      <text>保存</text>
    </view>
  </view>
</view>
