page {
  height: 100%;
  overflow: hidden;
}

page::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.container {
  height: 100vh;
  background-color: var(--page-bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll-container {
  flex: 1;
  overflow: hidden;
}

.scroll-container::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.content-wrapper {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.header-section {
  margin-bottom: 40rpx;
  padding: 0 8rpx;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.header-desc {
  display: block;
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

.agency-cards {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.agency-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.agency-card:active {
  transform: scale(0.98);
}

.student-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #a855f7 100%);
  box-shadow: 
    0 10rpx 40rpx rgba(102, 126, 234, 0.35),
    0 4rpx 12rpx rgba(118, 75, 162, 0.2);
}

.lawyer-card {
  background: linear-gradient(135deg, #f97316 0%, #ef4444 50%, #ec4899 100%);
  box-shadow: 
    0 10rpx 40rpx rgba(249, 115, 22, 0.35),
    0 4rpx 12rpx rgba(239, 68, 68, 0.2);
}

.card-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.deco-1 {
  width: 200rpx;
  height: 200rpx;
  top: -60rpx;
  right: -40rpx;
}

.deco-2 {
  width: 120rpx;
  height: 120rpx;
  bottom: 40rpx;
  left: -30rpx;
}

.card-main {
  position: relative;
  padding: 48rpx 40rpx 48rpx 48rpx;
  z-index: 1;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.icon-container {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.card-icon {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(0) invert(1);
}

.title-area {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.card-tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.15);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

.card-body {
  margin-bottom: 32rpx;
}

.card-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.feature-tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.card-footer {
  margin-top: 8rpx;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  padding: 18rpx 36rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
  background: #ffffff;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 10rpx;
}

.student-card .btn-text {
  color: #764ba2;
}

.lawyer-card .btn-text {
  color: #ef4444;
}

.btn-arrow {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.7;
}

.student-card .btn-arrow {
  filter: invert(35%) sepia(50%) saturate(800%) hue-rotate(230deg);
}

.lawyer-card .btn-arrow {
  filter: invert(35%) sepia(90%) saturate(1000%) hue-rotate(340deg);
}

.qa-section {
  margin-bottom: 32rpx;
}

.qa-header {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--active-bg) 100%);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
}

.qa-header-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, #a855f7 100%);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.qa-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
}

.qa-header-text {
  display: flex;
  flex-direction: column;
}

.qa-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.qa-subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.qa-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.qa-category {
  background: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  background: var(--card-bg);
  transition: background-color 0.4s ease-in-out;
}

.category-header:active {
  background: var(--active-bg);
}

.category-header.expanded {
  background: var(--tag-bg);
}

.category-left {
  display: flex;
  align-items: center;
}

.category-icon-box {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.category-icon-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.category-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.category-arrow-box {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-arrow {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.5;
  transition: transform 0.4s ease-in-out;
}

.category-arrow.expanded {
  transform: rotate(90deg);
  opacity: 0.8;
}

.qa-items {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-10rpx);
  transition: max-height 0.4s ease-in-out, opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
}

.qa-items.expanded {
  max-height: 3000rpx;
  opacity: 1;
  transform: translateY(0);
}

.qa-item {
  margin-top: 8rpx;
}

.qa-question {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 16rpx;
  transition: background 0.2s ease;
}

.qa-question:active {
  background: var(--active-bg);
}

.question-badge {
  min-width: 56rpx;
  height: 40rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, #3b82f6 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  flex-shrink: 0;
}

.question-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
  line-height: 1.4;
}

.qa-arrow {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.4;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

.qa-arrow.expanded {
  transform: rotate(90deg);
  opacity: 0.7;
}

.qa-answer {
  max-height: 0;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.qa-answer.expanded {
  max-height: 800rpx;
}

.answer-content {
  padding: 24rpx 28rpx 28rpx 28rpx;
  background: var(--page-bg);
  border-left: 6rpx solid;
  border-image: linear-gradient(180deg, var(--primary-color) 0%, #a855f7 100%) 1;
  margin: 0 28rpx 20rpx 28rpx;
  border-radius: 0 20rpx 20rpx 0;
}

.answer-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 10rpx;
}

.answer-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

@media (prefers-color-scheme: dark) {
  .student-card {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #a855f7 100%);
    box-shadow: 
      0 10rpx 40rpx rgba(79, 70, 229, 0.3),
      0 4rpx 12rpx rgba(124, 58, 237, 0.2);
  }

  .lawyer-card {
    background: linear-gradient(135deg, #ea580c 0%, #dc2626 50%, #db2777 100%);
    box-shadow: 
      0 10rpx 40rpx rgba(234, 88, 12, 0.3),
      0 4rpx 12rpx rgba(220, 38, 38, 0.2);
  }

  .action-btn {
    background: rgba(255, 255, 255, 0.95);
  }

  .btn-text {
    color: #1f2937;
  }

  .student-card .btn-text {
    color: #7c3aed;
  }

  .lawyer-card .btn-text {
    color: #dc2626;
  }

  .qa-header {
    background: linear-gradient(135deg, var(--card-bg) 0%, rgba(255, 255, 255, 0.05) 100%);
  }

  .category-header.expanded {
    background: rgba(59, 130, 246, 0.15);
  }

  .answer-content {
    background: rgba(255, 255, 255, 0.03);
  }
}
