/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: var(--page-bg);
  display: flex;
  flex-direction: column;
}

/* 内容包装器 */
.content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 滚动区域 */
.scroll-container {
  flex: 1;
  height: 0;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 200rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 200rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.3;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 40rpx;
}

.empty-action {
  background: var(--primary-color);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(17, 82, 212, 0.3);
}

.empty-action:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 切换标签栏 */
.tab-bar {
  display: flex;
  align-items: center;
  margin: 32rpx;
  margin-bottom: 32rpx;
  background-color: var(--active-bg);
  padding: 12rpx;
  border-radius: 24rpx;
  position: relative;
}

/* 滑动指示器 - 三个Tab */
.active-indicator {
  position: absolute;
  top: 12rpx;
  bottom: 12rpx;
  left: 12rpx;
  width: calc((100% - 24rpx) / 3);
  background-color: var(--primary-color);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(17, 82, 212, 0.25);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1;
}

/* 指示器位置 - 三个Tab */
.pos-civil_complaint { transform: translateX(0%); }
.pos-report_letter { transform: translateX(100%); }
.pos-negotiation_letter { transform: translateX(200%); }

/* 标签项 */
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-sub);
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: color 0.3s ease;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-item.active {
  background-color: transparent;
  color: #ffffff;
  font-weight: 600;
  box-shadow: none;
}

/* 文书列表 */
.document-list {
  padding: 0 32rpx;
}

/* 文书卡片 - 统一样式 */
.doc-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.doc-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

/* 草稿卡片特殊样式 - 仅多出虚线边框 */
.doc-card.draft {
  border: 2rpx dashed var(--primary);
}

/* 卡片头部：标题和状态 */
.doc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 标题 */
.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

/* 状态标签 */
.doc-status {
  flex-shrink: 0;
}

.status-text {
  font-size: 22rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

/* 草稿状态 - 蓝色 */
.status-draft .status-text {
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.08);
}

/* 已完成状态 - 绿色 */
.status-completed .status-text {
  color: #10b981;
  background: rgba(16, 185, 129, 0.08);
}

/* 卡片内容区域 */
.doc-body {
  margin-bottom: 20rpx;
}

/* 信息行 */
.doc-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.doc-info-row:last-child {
  margin-bottom: 0;
}

/* 标签 */
.doc-label {
  font-size: 28rpx;
  color: #999999;
  flex-shrink: 0;
}

/* 内容值 */
.doc-value {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 案由（旧样式兼容） */
.doc-case-reason {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 诉讼请求摘要（旧样式兼容） */
.doc-claims {
  font-size: 28rpx;
  color: var(--text-sub);
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 卡片底部：时间和编辑 */
.doc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 时间区域 */
.doc-time {
  display: flex;
  align-items: center;
}

/* 时钟图标 */
.time-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
  margin-right: 8rpx;
}

/* 时间 */
.doc-meta {
  font-size: 24rpx;
  color: #999999;
}

/* 编辑按钮 */
.doc-edit {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 500;
}

/* 箭头（旧样式兼容） */
.arrow-right {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}

/* Tab 空状态 */
.tab-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 600rpx;
  padding: 120rpx 0;
}

.tab-empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.4;
  margin-bottom: 32rpx;
  filter: grayscale(100%);
}

.tab-empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.tab-empty-subtext {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 32rpx;
}

.tab-empty-action {
  background: #3b82f6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.3);
}

.tab-empty-action:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 底部安全区域 */
.bottom-safe-area {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* 暗黑模式适配 */
@media (prefers-color-scheme: dark) {
  /* 卡片背景 */
  .doc-card {
    background: var(--card-bg);
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  }

  /* 标题颜色 */
  .doc-title {
    color: var(--text-main);
  }

  /* 标签颜色 */
  .doc-label {
    color: var(--text-sub);
  }

  /* 内容值颜色 */
  .doc-value {
    color: var(--text-main);
  }

  /* 底部边框 */
  .doc-footer {
    border-top-color: var(--divider-color);
  }

  /* 时间颜色 */
  .doc-meta {
    color: var(--text-sub);
  }

  /* 时间图标 */
  .time-icon {
    filter: invert(1);
    opacity: 0.6;
  }

  /* 箭头 */
  .arrow-right {
    filter: invert(1);
    opacity: 0.6;
  }

  /* 空白页图标 */
  .tab-empty-img {
    filter: grayscale(100%) invert(1);
    opacity: 0.5;
  }
}