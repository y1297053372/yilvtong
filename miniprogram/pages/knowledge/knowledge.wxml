<view class="container">
  <sub-header title="知识库" background="var(--page-bg)"></sub-header>

  <!-- Remove padding-top completely, sub-header component already has a placeholder -->
  <view class="content-area">
    <!-- Level 1 Categories (Horizontal Icons) -->
    <view class="level1-container">
      <view class="level1-list">
        <!-- Background Slider Indicator -->
        <view class="level1-active-indicator" style="left: calc(16px + (100% - 32px) * {{currentTabIndex}} / 4 + (100% - 32px) / 8 - {{iconBoxSize}}px / 2); width: {{iconBoxSize}}px; height: {{iconBoxSize}}px; background-color: {{level1IndicatorColor}}; box-shadow: 0 6px 16px {{level1IndicatorShadow}}; border-radius: 16px;"></view>

        <view class="level1-item {{currentTab === item.id ? 'active' : ''}}" 
              wx:for="{{categories}}" 
              wx:key="id" 
              bindtap="onTabTap" 
              data-id="{{item.id}}"
              data-index="{{index}}"
              data-color="{{item.activeColor}}"
              data-shadow="{{item.shadowColor}}">
          <view class="icon-box" style="background-color: {{currentTab === item.id ? 'transparent' : (isDarkMode ? item.darkBgColor : item.bgColor)}}; width: {{iconBoxSize}}px; height: {{iconBoxSize}}px;">
            <view class="level1-icon-wrapper" style="width: {{iconBoxSize * 0.55}}px; height: {{iconBoxSize * 0.55}}px;">
              <!-- 激活状态：白色图标 -->
              <image wx:if="{{currentTab === item.id}}" class="level1-icon" src="{{item.icon}}" mode="aspectFit" style="filter: brightness(0) invert(1);"></image>
              
              <!-- 未激活状态：显示主题色 -->
              <image wx:else class="level1-icon level1-icon-{{item.id}}" src="{{item.icon}}" mode="aspectFit"></image>
            </view>
          </view>
          <text class="level1-name" style="{{currentTab === item.id ? 'font-weight: 600;' : ''}}">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="main-body">
      <!-- Level 2 Categories (Vertical Sidebar) -->
      <scroll-view scroll-y class="sidebar">
        <!-- Background Slider Indicator -->
        <view class="sidebar-active-indicator" style="top: {{sidebarIndicatorTop}}px"></view>

        <view class="sidebar-item {{currentSubTab === item.id ? 'active' : ''}}"
              wx:for="{{subCategories[currentTab]}}" 
              wx:key="id"
              bindtap="onSubTabTap"
              data-id="{{item.id}}"
              data-index="{{index}}">
          
          <!-- Icon Container -->
          <view class="sidebar-icon-box">
            <!-- 激活状态：品牌蓝色 -->
            <image wx:if="{{currentSubTab === item.id}}" class="sidebar-icon sidebar-icon-active icon-blue" src="{{item.icon}}" mode="aspectFit"></image>
            
            <!-- 未激活状态：灰色 -->
            <image wx:else class="sidebar-icon icon-gray" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          
          <text class="sidebar-text">{{item.name}}</text>
        </view>
      </scroll-view>

      <!-- Article List Container (Right Side) -->
      <view class="right-content">
        <!-- Level 3 Categories Filter (Fixed Header) -->
        <view class="filter-bar" hidden="{{!currentSubCategory || !currentSubCategory.children}}">
          <scroll-view scroll-x class="filter-scroll" enable-flex>
            <view class="filter-flex-container">
              <view class="filter-item {{currentChildTab === 'all' ? 'active' : ''}}" 
                    bindtap="onChildTabTap" 
                    data-id="all">全部</view>
              <block wx:if="{{currentSubCategory && currentSubCategory.children}}">
                <view class="filter-item {{currentChildTab === child.id ? 'active' : ''}}" 
                      wx:for="{{currentSubCategory.children}}" 
                      wx:for-item="child" 
                      wx:key="id"
                      bindtap="onChildTabTap"
                      data-id="{{child.id}}">
                  {{child.name}}
                </view>
              </block>
              <view style="width: 16px; flex-shrink: 0;"></view>
            </view>
          </scroll-view>
        </view>

        <!-- Scrollable Article List -->
        <scroll-view type="list" scroll-y class="article-scroll" enable-flex bindscroll="onScroll" scroll-top="{{scrollTop}}" scroll-with-animation>
          <view class="article-list">
          <view class="article-card" wx:for="{{articles}}" wx:key="id" bindtap="onArticleTap" data-id="{{item.id}}">
            <!-- 上图 -->
          <image src="{{item.image || DEFAULT_IMAGES.UNSPLASH_FALLBACK}}" mode="aspectFill" class="article-image" lazy-load="{{true}}"/>
          <!-- 下文 -->
            <view class="article-info">
              <view class="article-meta">
                <text class="meta-tag">{{item.views}}浏览</text>
                <text class="meta-date">{{item.date}}</text>
              </view>
              <text class="article-title">{{item.title}}</text>
              <text class="article-summary">{{item.summary || '暂无摘要'}}</text>
            </view>
          </view>
        </view>

        <view class="loading-container" wx:if="{{loading}}">
          <image class="loading-spinner" src="/images/icons/loading.svg" mode="aspectFit"></image>
          <text class="loading-text">加载中...</text>
        </view>
    
        <view class="empty-tip" wx:if="{{!loading && articles.length === 0}}">
          <text>暂无内容</text>
        </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- Back To Top -->
  <view class="back-to-top {{showBackTop ? 'show' : ''}}" bindtap="onBackToTop">
    <image class="arrow-up" src="/images/icons/top.svg" mode="aspectFit"></image>
  </view>
</view>
