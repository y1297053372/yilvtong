/* pages/knowledge/knowledge.wxss */
page {
  height: 100vh;
  overflow: hidden;
}

.container {
  height: 100vh;
  background-color: var(--page-bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Content Area to fill remaining space */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* Prevent global scroll */
}

/* Level 1 Categories */
.level1-container {
  background-color: var(--page-bg); /* 与主页背景色一致 */
  padding: 16px; 
  border-bottom: none;
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 0; /* Don't shrink */
}

.level1-list {
  display: flex;
  width: 100%;
  justify-content: space-between; 
  box-sizing: border-box;
  background-color: var(--card-bg);
  border-radius: 16px; 
  padding: 20px 16px 16px 16px; 
  box-shadow: var(--shadow-md);
  position: relative; /* For absolute positioning of indicator */
}

/* Level 1 Active Indicator - Sliding Colored Box */
.level1-active-indicator {
  position: absolute;
  top: 20px; /* Same as padding-top of list */
  /* Width and Height set inline via style binding */
  border-radius: 16px;
  /* 恢复过渡动画 */
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1;
  /* Transform origin center to scale if needed */
  background-color: var(--tag-bg); /* 浅色模式：浅蓝背景 */
  box-shadow: none;
}

@media (prefers-color-scheme: dark) {
  .level1-active-indicator {
    background-color: var(--primary-color); /* 深色模式：深蓝背景 */
    box-shadow: var(--shadow-md);
  }
}

.level1-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.6;
  transition: all 0.3s;
  position: relative;
  /* padding-bottom: 12px;  移除旧的 padding */
  box-sizing: border-box; /* Include padding/border in width */
  flex: 1; /* 均分宽度 */
  z-index: 2; /* Above indicator */
}

.active-bar {
  display: none; /* Hide old bar */
}

/* Remove old active styles that changed icon color */
.level1-item.active {
  opacity: 1;
  transform: none;
}

.level1-item.active .level1-name {
  font-weight: 700;
  color: #000000; /* 浅色模式：黑色文字 */
}

@media (prefers-color-scheme: dark) {
  .level1-item.active .level1-name {
    color: #ffffff !important; /* 深色模式：白色文字 */
  }
}

.level1-item.active .level1-icon {
  /* 浅色模式：保持原色 (假设原图适合浅底) */
  filter: none;
  position: static;
  left: 0;
}

@media (prefers-color-scheme: dark) {
  .level1-item.active .level1-icon {
    /* 深色模式：转为白色 (配合深蓝背景) */
    filter: brightness(0) invert(1);
  }
}

.icon-box {
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  transition: all 0.3s ease;
  background-color: transparent;
}

/* 深色模式下未激活图标背景色 */
@media (prefers-color-scheme: dark) {
  .level1-item:not(.active) .icon-box {
    background-color: #2d3748 !important;
  }
}

.level1-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden; /* 关键：隐藏移出的原始图标 */
}

.level1-icon {
  width: 100%;
  height: 100%;
}

/* 未选中一级分类图标：显示对应主题色 */
.level1-icon-evidence {
  filter: invert(48%) sepia(76%) saturate(2030%) hue-rotate(197deg) brightness(95%) contrast(101%);
}

.level1-icon-channel {
  filter: invert(53%) sepia(64%) saturate(608%) hue-rotate(88deg) brightness(96%) contrast(91%);
}

.level1-icon-law {
  filter: invert(54%) sepia(91%) saturate(2164%) hue-rotate(360deg) brightness(101%) contrast(97%);
}

.level1-icon-topic {
  filter: invert(30%) sepia(85%) saturate(1500%) hue-rotate(250deg) brightness(95%) contrast(105%);
}

.level1-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-main);
  white-space: nowrap;
}

/* Main Body Layout */
.main-body {
  flex: 1;
  display: flex;
  overflow: hidden; /* Ensure only children scroll */
}

/* Sidebar (Level 2/3) */
.sidebar {
  width: 86px;
  background-color: var(--page-bg); /* Changed to match main background */
  border-right: 1rpx solid var(--border-color);
  height: 100%;
  overflow-y: hidden; /* Hide scrollbar/disable scroll as requested */
  position: relative; /* For absolute positioning of indicator */
}

/* Sidebar Active Indicator - Sliding Blue Bar */
.sidebar-active-indicator {
  position: absolute;
  left: 0;
  width: 4px; /* Only the width of the bar */
  height: 24px; /* Height of the indicator bar */
  background-color: var(--primary-color);
  border-top-right-radius: 4px;
  border-bottom-right-radius: 4px;
  transition: top 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 3; /* Above everything */
  /* Remove white background block styles */
  border-left: none;
}

.sidebar-item {
  padding: 16px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  gap: 8px;
  color: var(--text-sub); /* Default gray color for icon and text */
  z-index: 2; /* Above base */
  height: 84px; /* Fixed height for calculation */
  box-sizing: border-box;
}

/* Restore active item styles */
.sidebar-item.active {
  background-color: transparent; 
}

.sidebar-item.active .sidebar-text {
  color: var(--primary-color); 
  font-weight: 600;
}

.sidebar-item.active .sidebar-icon-box {
  background-color: var(--tag-bg); 
}

.sidebar-icon-box {
  width: 40px;
  height: 40px;
  border-radius: 50%; /* Circle background */
  background-color: var(--active-bg); /* Default background */
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  overflow: hidden; /* Ensure displaced image is hidden */
  flex-shrink: 0; /* 防止被挤压成椭圆 */
}

.sidebar-icon {
  width: 24px;
  height: 24px;
}

/* 未选中：灰色 */
.icon-gray {
  filter: grayscale(100%) opacity(0.5);
}

/* 选中：蓝色 */
.icon-blue {
  filter: invert(48%) sepia(76%) saturate(2030%) hue-rotate(197deg) brightness(95%) contrast(101%);
}

@media (prefers-color-scheme: dark) {
  .icon-gray {
    /* 深色模式下反转颜色，使其变成白色/浅灰色 */
    filter: grayscale(100%) invert(1) opacity(0.7);
  }
}

.sidebar-text {
  font-size: 12px;
  text-align: center;
  line-height: 1.2;
}

/* Active State */
.sidebar-item.active {
  background-color: transparent; /* No full background change */
}

.sidebar-item.active .sidebar-text {
  color: var(--primary-color); /* Deep blue theme color text */
  font-weight: 600;
}

.sidebar-item.active .sidebar-icon-box {
  background-color: var(--tag-bg); /* Light blue theme color circle background */
}

/* Left Indicator Bar - Removed as it's now part of the sliding block */
/* .sidebar-indicator { ... } */

/* Filter Bar (Level 3) */
.filter-bar {
  background-color: var(--page-bg); /* Changed to match main background */
  padding: 12px 0 12px 10px; /* Remove right padding for scroll bleed */
  border-bottom: 1rpx solid var(--border-color);
  width: 100%;
  height: 56px;
  box-sizing: border-box;
  flex-shrink: 0; /* Don't shrink */
}

.filter-scroll {
  display: flex;
  height: 100%;
  width: 100%;

}

/* 新增的内部容器样式 */
.filter-flex-container {
  display: flex;
  flex-direction: row; /* 显式声明横向 */
  align-items: center;
  height: 100%;
}

.filter-item {
  font-size: 13px;
  color: var(--text-sub);
  background-color: var(--card-bg); /* Card style white background */
  padding: 6px 16px;
  border-radius: 16px;
  margin-right: 12px;
  border: 1rpx solid var(--border-color);
  transition: all 0.2s;
  flex-shrink: 0; /* Prevent shrinking */
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-item.active {
  color: #ffffff;
  background-color: var(--primary-color);
  border-color: var(--primary-color);
  font-weight: 500;
  box-shadow: 0 2px 6px rgba(17, 82, 212, 0.2);
}

/* Remove last-child margin reset as we use wrap */

/* Right Content Container */
.right-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100%;
}

/* Article List Scroll View */
.article-scroll {
  flex: 1;
  /* height: 0;  Wait, flex: 1 works better usually, but height: 0 ensures flex calculation */
  height: 100%;
  background-color: var(--page-bg);
  width: 100%;
  display: flex;
  flex-direction: column;
}

.article-list {
  padding: 16px 10px 80px 10px;
}

.article-card {
  background: var(--card-bg);
  border-radius: 16px;
  overflow: hidden; /* 确保图片圆角生效 */
  padding: 0; /* 移除内边距，让图片贴边 */
  border: none;
  box-shadow: var(--shadow-md); /* 增大阴影 */
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-bottom: 16px;
}

.article-image {
  width: 100%;
  /* 
    16:9 Aspect Ratio
    卡片宽度 = 屏幕宽度 - 86px (sidebar) - 20px (padding)
    假设屏幕宽 375px，则卡片宽 269px
    高度 = 269 * 9 / 16 ≈ 151.3px (302.6rpx)
  */
  height: 303rpx; 
  display: block;
  object-fit: cover;
  background-color: var(--active-bg);
}

.article-info {
  padding: 24rpx; /* 改为与首页一致的 24rpx */
  display: flex;
  flex-direction: column;
  gap: 8rpx; /* 改为与首页一致的 8rpx */
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 2px;
}

.meta-tag {
  background-color: var(--tag-bg);
  color: var(--tag-text);
  font-size: 10px;
  font-weight: bold;
  padding: 2px 8px;
  border-radius: 16px;
}

.meta-date {
  font-size: 10px;
  color: var(--text-placeholder);
  font-weight: 500;
}

.article-title {
  font-size: 15px; /* 改为与首页一致的 15px */
  font-weight: bold;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 0;
}

.article-summary {
  font-size: 12px; /* 改为与首页一致的 12px */
  color: var(--text-sub);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Back To Top moved to app.wxss */

/* Loading & Empty States */
.loading-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px 0;
  gap: 8px;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 12px;
  color: var(--text-placeholder);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.empty-tip {
  text-align: center;
  padding: 40px;
  color: var(--text-placeholder);
  font-size: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
