.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--page-bg);
  position: relative;
}

.scroll-area {
  flex: 1;
  height: 0;
  width: 100%;
}

.list-container {
  padding: 16px;
}

.list-item {
  background: var(--card-bg);
  padding: 16px;
  border-radius: 12px;
  margin-bottom: 12px;
  display: flex;
  justify-content: space-between;
  align-items: stretch; /* 让高度自适应 */
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden; /* 裁剪 */
  padding-right: 0; /* 移除右侧内边距，让图片贴边 */
}

.image-wrapper {
  width: 140px; /* 进一步加宽图片区域，增强视觉冲击力 */
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  margin-left: 0;
  flex-shrink: 0;
}

.item-content {
  flex: 1;
  /* 图片宽度 140px - 渐变宽度 80px = 60px 是纯图区域 */
  /* 文字内容需要避开纯图区域，并进入渐变区域一点点 */
  /* padding-right: 140px - 40px (进入渐变区深度) = 100px */
  padding-right: 100px; 
  display: flex;
  flex-direction: column;
  border-radius: 8px;
  z-index: 2;
  justify-content: center;
  position: relative; 
  min-height: 80px;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 2px;
}

.item-category {
  font-size: 10px;
  color: var(--tag-text);
  background-color: var(--tag-bg);
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: bold;
}

.item-date {
  font-size: 11px;
  color: var(--text-sub);
}

.item-title {
  font-size: 15px;
  font-weight: bold;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-summary {
  font-size: 12px;
  color: var(--text-sub);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-image {
  width: 100%;
  height: 100%;
  border-radius: 0;
  background-color: var(--active-bg);
  display: block;
}

.image-mask {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 80px; /* 增大渐变宽度 */
  background: var(--mask-gradient);
  z-index: 1;
}

.empty-tip {
  text-align: center;
  padding: 40px;
  color: var(--text-placeholder);
  font-size: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 空状态样式 - 参考 my-documents */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 200rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.4;
  margin-bottom: 40rpx;
  filter: grayscale(100%);
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 40rpx;
}

.empty-action {
  background: var(--primary-color);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(17, 82, 212, 0.3);
}

.empty-action:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* Loading & Empty States */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: var(--page-bg);
  z-index: 10;
  gap: 8px;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 12px;
  color: var(--text-placeholder);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}


