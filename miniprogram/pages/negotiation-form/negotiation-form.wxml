<wxs module="tools">
  module.exports.includes = function(arr, item) {
    return arr.indexOf(item) > -1;
  }
</wxs>

<view class="container" style="{{pageScrollDisabled ? 'overflow: hidden; height: 100vh;' : ''}}">
  <!-- Privacy Consent Modal -->
  <privacy-consent 
    show="{{showPrivacyModal}}" 
    document-type="negotiation_letter" 
    bind:consent="onPrivacyConsent"
    bind:showChange="onPrivacyShowChange"
  />
  
  <!-- Fixed Wrapper for Header + Steps -->
  <view class="fixed-header-wrapper" id="fixed-header">
    <sub-header title="协商函生成" id="formHeader" showPlaceholder="{{false}}" background="var(--nav-bg)"></sub-header>
    
    <!-- Steps Progress -->
    <view class="steps-header" style="padding-top: {{headerHeight - 20}}px; padding-bottom: 0rpx;">
      <view class="step-item {{index < currentStep ? 'completed' : ''}} {{index === currentStep ? 'current' : ''}}" wx:for="{{steps}}" wx:key="index" bindtap="jumpToStep" data-step="{{index}}">
        <view class="step-circle">{{index + 1}}</view>
        <text class="step-title">{{item.title}}</text>
        <view class="step-line" wx:if="{{index < steps.length - 1}}"></view>
      </view>
    </view>
  </view>

  <!-- Content Area -->
  <view class="form-content" style="padding-top: {{totalHeaderHeight - 5}}px; padding-bottom: calc({{currentStep === 4 ? '0' : '40'}}rpx + {{paddingBottom}}px); min-height: 100vh; height: {{currentStep === 4 ? '100vh' : 'auto'}}; overflow: {{currentStep === 4 ? 'hidden' : 'visible'}};">
    
    <!-- Step 0: 收发方信息 -->
    <view wx:if="{{currentStep === 0}}">
      <!-- 发函方信息 -->
      <view class="form-section">
        <view class="section-title">发函方信息（我方）</view>
        <view class="form-group">
          <text class="form-label">姓名</text>
          <input class="form-input" id="input_sender_name" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" placeholder="请输入您的姓名" value="{{formData.sender.name}}" data-field="sender.name" bindinput="handleInput" cursor-spacing="30"/>
        </view>
        <view class="form-group">
          <text class="form-label">联系方式</text>
          <input class="form-input" id="input_sender_contact" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" type="text" placeholder="请输入联系方式" value="{{formData.sender.contact}}" data-field="sender.contact" bindinput="handleInput" cursor-spacing="30"/>
        </view>
        <view class="form-group" wx:if="{{consentIdCard === true}}">
          <text class="form-label">身份证号码</text>
          <input class="form-input" id="input_sender_idcard" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" type="idcard" placeholder="请输入身份证号码" value="{{formData.sender.idCard}}" data-field="sender.idCard" bindinput="onIdCardInput" cursor-spacing="30"/>
        </view>
        <view class="form-group" wx:if="{{consentIdCard === false}}">
          <text class="form-label">性别</text>
          <picker range="{{genderOptions}}" bindchange="onGenderChange" data-field="sender.gender">
            <view class="form-picker">
              <text class="picker-text" wx:if="{{formData.sender.gender}}">{{formData.sender.gender}}</text>
              <text class="picker-placeholder" wx:else>请选择性别</text>
              <image src="/images/icons/arrow-right.svg" class="picker-arrow"></image>
            </view>
          </picker>
        </view>
        <view class="form-group" wx:if="{{consentIdCard === false}}">
          <text class="form-label">出生日期</text>
          <picker mode="date" bindchange="onBirthDateChange" data-field="sender.birthDate" start="1900-01-01" end="2025-12-31">
            <view class="form-picker">
              <text class="picker-text" wx:if="{{formData.sender.birthDate}}">{{formData.sender.birthDate}}</text>
              <text class="picker-placeholder" wx:else>请选择出生日期</text>
              <image src="/images/icons/arrow-right.svg" class="picker-arrow"></image>
            </view>
          </picker>
        </view>
      </view>

      <!-- 收函方信息 -->
      <view class="form-section">
        <view class="section-title">收函方信息（商家）</view>
        <view class="form-group">
          <text class="form-label">电商平台名称</text>
          <input class="form-input" id="input_receiver_platform" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" placeholder="如：淘宝、京东、拼多多" value="{{formData.receiver.platform}}" data-field="receiver.platform" bindinput="handleInput" cursor-spacing="30"/>
        </view>
        <view class="form-group">
          <text class="form-label">店铺名称</text>
          <input class="form-input" id="input_receiver_shopname" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" placeholder="请输入店铺名称" value="{{formData.receiver.shopName}}" data-field="receiver.shopName" bindinput="handleInput" cursor-spacing="30"/>
        </view>
        <view class="form-group">
          <text class="form-label">服装类型</text>
          <view class="radio-group segmented" style="margin-bottom: 0;">
            <view class="segment-indicator segment-pos-{{formData.receiver.isCustom ? 1 : 0}}"></view>
            <view class="radio-segment {{formData.receiver.isCustom ? '' : 'selected'}}" bindtap="onIsCustomChange" data-value="false">
              <text class="radio-segment-text">非定制服装</text>
            </view>
            <view class="radio-segment {{formData.receiver.isCustom ? 'selected' : ''}}" bindtap="onIsCustomChange" data-value="true">
              <text class="radio-segment-text">定制服装</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Step 1: 交易背景 -->
    <view wx:if="{{currentStep === 1}}">
      <view class="form-section">
        <view class="section-title">交易背景</view>
        <view class="form-group">
          <text class="form-label">订单编号</text>
          <input class="form-input" id="input_transaction_orderid" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" placeholder="请输入订单编号" value="{{formData.transaction.orderId}}" data-field="transaction.orderId" bindinput="handleInput" cursor-spacing="30"/>
        </view>
        <view class="form-group">
          <text class="form-label">购衣/定制付款金额（元）</text>
          <input class="form-input" id="input_transaction_price" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" type="digit" placeholder="请输入付款金额" value="{{formData.transaction.price}}" data-field="transaction.price" bindinput="handleInput" cursor-spacing="30"/>
        </view>
        <view class="form-group">
          <text class="form-label">下单日期</text>
          <picker mode="date" value="{{formData.transaction.orderDate}}" bindchange="onDateChange" data-field="transaction.orderDate">
            <view class="form-picker">
              <text class="picker-text" wx:if="{{formData.transaction.orderDate}}">{{formData.transaction.orderDate}}</text>
              <text class="picker-placeholder" wx:else>请选择下单日期</text>
              <image src="/images/icons/arrow-right.svg" class="picker-arrow"></image>
            </view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">服装品类及款式</text>
          <input class="form-input" id="input_transaction_producttype" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" placeholder="如：连衣裙、西装、T恤等" value="{{formData.transaction.productType}}" data-field="transaction.productType" bindinput="handleInput" cursor-spacing="30"/>
        </view>
        <view class="form-group">
          <text class="form-label">发货日期</text>
          <picker mode="date" value="{{formData.transaction.shipDate}}" bindchange="onDateChange" data-field="transaction.shipDate">
            <view class="form-picker">
              <text class="picker-text" wx:if="{{formData.transaction.shipDate}}">{{formData.transaction.shipDate}}</text>
              <text class="picker-placeholder" wx:else>请选择发货日期</text>
              <image src="/images/icons/arrow-right.svg" class="picker-arrow"></image>
            </view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">签收日期</text>
          <picker mode="date" value="{{formData.transaction.receiveDate}}" bindchange="onDateChange" data-field="transaction.receiveDate">
            <view class="form-picker">
              <text class="picker-text" wx:if="{{formData.transaction.receiveDate}}">{{formData.transaction.receiveDate}}</text>
              <text class="picker-placeholder" wx:else>请选择签收日期</text>
              <image src="/images/icons/arrow-right.svg" class="picker-arrow"></image>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- Step 2: 侵权事实 -->
    <view wx:if="{{currentStep === 2}}">
      <view class="form-section">
        <view class="section-title">侵权事实</view>
        <view class="form-group">
          <text class="form-label">问题类型</text>
          <view class="radio-group list">
            <view class="radio-list-card {{formData.infringement.type === item.value ? 'selected' : ''}}" 
                   wx:for="{{infringementOptions}}" wx:key="value"
                   bindtap="onInfringementTypeChange" data-value="{{item.value}}">
              <view class="radio-list-radio"></view>
              <view class="radio-list-content">
                <text class="radio-list-title">{{item.label}}</text>
                <text class="radio-list-desc">{{item.desc}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">具体问题描述</text>
          <textarea class="form-textarea" style="min-height: 80rpx; height: 160rpx;" id="textarea_infringement_desc" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" placeholder="请详细描述商品存在的问题" value="{{formData.infringement.description}}" data-field="infringement.description" bindinput="handleInput" cursor-spacing="30" maxlength="200"/>
        </view>
      </view>
    </view>

    <!-- Step 3: 协商诉求 -->
    <view wx:if="{{currentStep === 3}}">
      <view class="form-section">
        <view class="section-title" style="justify-content: space-between;">
          <text>协商诉求（可多选）</text>
          <view class="selected-count" wx:if="{{formData.claims.length > 0}}">
            已选 {{formData.claims.length}} 项
          </view>
        </view>
        <view class="radio-group list">
          <block wx:for="{{claimOptions}}" wx:key="id">
            <!-- 选择卡片 -->
            <view class="selection-header {{tools.includes(formData.claims, item.id) ? 'selected' : ''}} {{item.hasInput ? 'has-sub' : ''}}"
                  bindtap="onClaimItemTap" data-id="{{item.id}}">
              <view class="checkbox-list-check"></view>
              <text class="checkbox-list-text">{{item.label}}</text>
            </view>
            
            <!-- 子输入框 -->
            <view class="sub-input-container" wx:if="{{tools.includes(formData.claims, item.id) && item.hasInput}}">
              <view class="sub-input-group">
                <view class="label-row">
                  <text class="sub-input-label">{{item.input1Label}}</text>
                </view>
                <view class="sub-input-box">
                  <view class="sub-input-icon-box" wx:if="{{item.id === '1' || item.id === '4' || item.id === '5' || item.id === '6'}}">
                    <image class="sub-input-icon-img" src="/images/icons/money.svg" mode="aspectFit"/>
                  </view>
                  <view class="sub-input-icon-box" wx:if="{{item.id === '3'}}">
                    <image class="sub-input-icon-img" src="/images/icons/calendar.svg" mode="aspectFit"/>
                  </view>
                  <picker wx:if="{{item.input1Type === 'date'}}" mode="date" value="{{formData.claimInputs[item.id + '_1']}}" bindchange="onClaimDateChange" data-id="{{item.id}}" data-field="1">
                    <view style="display: flex; align-items: center; height: 100%;">
                      <text class="picker-text" wx:if="{{formData.claimInputs[item.id + '_1']}}">{{formData.claimInputs[item.id + '_1']}}</text>
                      <text class="picker-placeholder" wx:else>{{item.input1Placeholder}}</text>
                    </view>
                  </picker>
                  <input wx:else class="sub-input" id="input_claim_{{item.id}}_1" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" type="{{(item.id === '1' || item.id === '4' || item.id === '5' || item.id === '6') ? 'digit' : 'text'}}" placeholder="{{item.input1Placeholder}}" value="{{formData.claimInputs[item.id + '_1']}}" data-id="{{item.id}}" data-field="1" bindinput="onClaimInput" cursor-spacing="30"/>
                </view>
              </view>
              <view class="sub-input-group" wx:if="{{item.hasInput2}}">
                <view class="label-row">
                  <text class="sub-input-label">{{item.input2Label}}</text>
                </view>
                <view class="sub-input-box">
                  <view class="sub-input-icon-box">
                    <image class="sub-input-icon-img" src="/images/icons/money.svg" mode="aspectFit"/>
                  </view>
                  <input class="sub-input" id="input_claim_{{item.id}}_2" adjust-position="{{false}}" bindfocus="onInputFocus" bindblur="onInputBlur" type="digit" placeholder="{{item.input2Placeholder}}" value="{{formData.claimInputs[item.id + '_2']}}" data-id="{{item.id}}" data-field="2" bindinput="onClaimInput" cursor-spacing="30"/>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <!-- 限期答复要求 -->
      <view class="form-section">
        <view class="section-title">
          <text>限期答复要求</text>
        </view>
        
        <!-- 工作日天数 -->
        <view class="form-group">
          <text class="form-label">要求答复期限（工作日）</text>
          <view class="input-box">
            <input class="form-input" type="digit" placeholder="请输入工作日天数，如：7" value="{{formData.deadline.days}}" data-field="deadline.days" bindinput="handleInput" cursor-spacing="30"/>
            <text class="input-suffix">个工作日</text>
          </view>
        </view>

        <!-- 最终日期 -->
        <view class="form-group">
          <text class="form-label">最迟答复日期</text>
          <view class="input-box">
            <picker mode="date" value="{{formData.deadline.finalDate}}" bindchange="onDeadlineDateChange">
              <view style="display: flex; align-items: center; height: 100%;">
                <text class="picker-text" wx:if="{{formData.deadline.finalDate}}">{{formData.deadline.finalDate}}</text>
                <text class="picker-placeholder" wx:else>请选择最迟答复日期</text>
              </view>
            </picker>
          </view>
        </view>

      </view>

    </view>

    <!-- Step 4: 生成结果 -->
    <view wx:if="{{currentStep === 4}}" style="height: 100%; display: flex; flex-direction: column;">
      <view class="form-section transparent-section" style="flex: 1; display: flex; flex-direction: column; overflow: hidden; margin-bottom: 0;">
        <view class="section-title" style="display: flex; justify-content: space-between; align-items: center; padding-left: 24rpx; flex-shrink: 0;">
          <text>生成结果预览</text>
        </view>

        <!-- Preview Box (Read Only, Partial) -->
        <view class="preview-box" bindtap="viewFullDocument" style="flex: 1; height: 0; overflow: hidden;" data-testid="preview-box">
          <view class="preview-mask">
             <text class="preview-mask-text">点击查看完整文书</text>
          </view>
          <!-- Document Title -->
          <view class="preview-doc-title">协商函</view>
          <text class="result-text-partial">{{generatedText}}</text>
        </view>

        <!-- Bottom Area: Buttons + Warning -->
        <view class="bottom-area" style="flex-shrink: 0; padding-bottom: 40rpx;">
            <!-- Button Group -->
            <view class="btn-group" style="margin-top: 24rpx; display: flex; flex-direction: column; gap: 20rpx;">
              <view style="display: flex; gap: 20rpx;">
                <button class="btn-secondary" bindtap="prevStep" style="width: auto; flex: 1;">上一步</button>
                <button class="btn-secondary" bindtap="showEvidenceModal" style="width: auto; flex: 1;">查看证据清单</button>
              </view>
              <button class="btn-primary" bindtap="exportPDF" style="width: 100%; background: linear-gradient(135deg, #2B32B2 0%, #1488CC 100%);">
                导出PDF
              </button>
            </view>

            <!-- Bottom Warning -->
            <view class="bottom-warning">
                <text>本工具为辅助生成，生成的文书仅供参考，不构成正式法律意见。正式使用前，建议根据自身情况咨询专业律师。建议用户在正式提交前请专业人士复核。</text>
            </view>
        </view>

      </view>
    </view>

    <!-- Evidence Modal -->
    <view class="modal-mask" wx:if="{{showEvidenceModal}}" bindtap="hideEvidenceModal"></view>
    <view class="modal-container" wx:if="{{showEvidenceModal}}">
      <view class="modal-header">
        <view class="modal-title-wrapper">
          <image class="modal-icon-bulb" src="/images/icons/bulb.svg" mode="aspectFit"></image>
          <text class="modal-title">证据清单（附相关凭证）</text>
        </view>
        <view class="modal-close" bindtap="hideEvidenceModal">×</view>
      </view>

      <scroll-view scroll-y class="modal-content">
        <view class="evidence-group">
          <view class="evidence-list">
            <view class="evidence-check-item">
              <image class="check-icon" src="/images/icons/check-circle.svg"></image>
              <text class="check-text">平台订单截图、支付凭证截图。</text>
            </view>
            <view class="evidence-check-item">
              <image class="check-icon" src="/images/icons/check-circle.svg"></image>
              <text class="check-text">商家商品宣传页面截图（含材质/尺寸/定制要求等核心承诺）。</text>
            </view>
            <view class="evidence-check-item">
              <image class="check-icon" src="/images/icons/check-circle.svg"></image>
              <text class="check-text">本人与商家的沟通记录截图（微信/平台客服/旺旺等）。</text>
            </view>
            <view class="evidence-check-item">
              <image class="check-icon" src="/images/icons/check-circle.svg"></image>
              <text class="check-text">商品实物照片/视频（展示材质不符/尺寸偏差/质量瑕疵等问题）。</text>
            </view>
            <!-- 仅当选择定制服装时显示 -->
            <view class="evidence-check-item" wx:if="{{formData.receiver.isCustom}}">
              <image class="check-icon" src="/images/icons/check-circle.svg"></image>
              <text class="check-text">定制需求确认记录、设计稿沟通记录。</text>
            </view>
            <view class="evidence-check-item">
              <image class="check-icon" src="/images/icons/check-circle.svg"></image>
              <text class="check-text">物流签收凭证、运费支付凭证、商品检测凭证（如有）。</text>
            </view>
            <view class="evidence-check-item">
              <image class="check-icon" src="/images/icons/check-circle.svg"></image>
              <text class="check-text">其他相关证据。</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="modal-footer-placeholder"></view>
    </view>
    
    <!-- Signature Modal -->
    <view class="modal-mask" wx:if="{{showSignatureModal}}" bindtap="hideSignatureModal"></view>
    <view class="modal-container" wx:if="{{showSignatureModal}}">
      <view class="modal-header">
        <view class="modal-title-wrapper">
          <image class="modal-icon-warning" src="/images/icons/edit.svg" mode="aspectFit"></image>
          <text class="modal-title">签名提示</text>
        </view>
        <view class="modal-close" bindtap="hideSignatureModal">×</view>
      </view>
      
      <view class="modal-content">
        <view class="signature-tips">
          <view class="tip-item">
            <text class="tip-number">1</text>
            <text class="tip-text">打印生成的协商函</text>
          </view>
          <view class="tip-item">
            <text class="tip-number">2</text>
            <text class="tip-text">在"发函人"处签名或盖章</text>
          </view>
          <view class="tip-item">
            <text class="tip-number">3</text>
            <text class="tip-text">也可按手印确认</text>
          </view>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-primary {{isGeneratingPDF ? 'loading' : ''}}" bindtap="openGeneratedPDF" disabled="{{isGeneratingPDF}}">
          <view wx:if="{{isGeneratingPDF}}" class="btn-loading-icon"></view>
          <text>{{isGeneratingPDF ? '正在生成PDF...' : '查看PDF'}}</text>
        </button>
      </view>
    </view>

    <!-- Disclaimer Modal -->
    <view class="modal-mask" wx:if="{{showDisclaimerModal}}"></view>
    <view class="modal-container" wx:if="{{showDisclaimerModal}}">
      <view class="modal-header">
        <view class="modal-title-wrapper">
          <image class="modal-icon-warning" src="/images/icons/warning.svg" mode="aspectFit"></image>
          <text class="modal-title">法律风险提示</text>
        </view>
        <view class="modal-close" bindtap="closeDisclaimerModal">×</view>
      </view>
      
      <view class="modal-content">
        <view class="warning-text-box">
          <text>本工具为辅助生成，生成的文书仅供参考，不构成正式法律意见。正式使用前，建议根据自身情况咨询专业律师。</text>
        </view>
        
        <view class="checkbox-container" bindtap="toggleDisclaimerCheckbox">
          <view class="checkbox {{disclaimerAccepted ? 'checked' : ''}}">
            <view class="checkmark" wx:if="{{disclaimerAccepted}}"></view>
          </view>
          <text class="checkbox-label">我已阅读并理解以上提示</text>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-primary" disabled="{{!disclaimerAccepted}}" bindtap="confirmDisclaimer">继续生成</button>
      </view>
    </view>

    <view class="footer-actions" wx:if="{{currentStep < 4}}">
      <button class="btn-secondary" bindtap="prevStep" wx:if="{{currentStep > 0}}">上一步</button>
      <button class="btn-primary" bindtap="nextStep" wx:if="{{currentStep < 3}}">下一步</button>
      <button class="btn-primary" bindtap="nextStep" wx:if="{{currentStep === 3}}">生成文书</button>
    </view>

  </view>
</view>
