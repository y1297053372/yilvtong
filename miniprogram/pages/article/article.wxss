/* pages/article/article.wxss */
.container {
  background-color: var(--card-bg);
  min-height: 100vh;
}

.content-wrapper {
  padding: 32rpx;
}

/* Header */
.article-header {
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid var(--divider-color);
  padding-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-category {
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 32rpx; /* 胶囊圆角 */
  background-color: var(--tag-bg); /* 默认值 */
  color: var(--tag-text); /* 默认值 */
}

/* 分类颜色变体 */
.meta-category.blue {
  background-color: var(--blue-bg);
  color: var(--blue-text);
}

.meta-category.green {
  background-color: var(--green-bg);
  color: var(--green-text);
}

.meta-category.orange {
  background-color: var(--orange-bg);
  color: var(--orange-text);
}

.meta-category.pink {
  background-color: var(--pink-bg);
  color: var(--pink-text);
}

.meta-divider {
  width: 1px;
  height: 24rpx;
  background-color: var(--text-placeholder); /* 稍微深一点的灰色分隔符 */
  margin: 0 24rpx;
}

.meta-date {
  font-size: 26rpx;
  color: var(--text-sub); /* 蓝灰色 */
}

.meta-views {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-sub);
}

.icon-eye {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

/* Body */
.article-body {
  font-size: 32rpx;
  color: var(--text-main); /* #334155 -> text-main */
  line-height: 1.8;
}

.paragraph {
  margin-bottom: 24rpx;
}

.paragraph.heading {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid var(--primary-color);
  line-height: 1.4;
}

.paragraph.text {
  text-align: justify;
}

/* Floating Action Buttons */
.floating-buttons {
  position: fixed;
  right: 32rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  z-index: 100;
}

.fab-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s, box-shadow 0.2s;
  border: none;
  padding: 0;
  margin: 0;
}

.fab-btn::after {
  border: none;
}

.fab-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.fab-icon {
  width: 44rpx;
  height: 44rpx;
}

.collect-btn .fab-icon {
  filter: grayscale(100%) brightness(0.6);
  transition: all 0.3s ease;
}

.collect-btn.active .fab-icon {
  filter: invert(70%) sepia(80%) saturate(800%) hue-rotate(10deg) brightness(100%) contrast(100%);
}

.share-btn .fab-icon {
  filter: invert(48%) sepia(85%) saturate(1500%) hue-rotate(160deg) brightness(95%) contrast(95%);
}

@media (prefers-color-scheme: dark) {
  .fab-btn {
    background: var(--card-bg);
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  }
  
  .fab-btn:active {
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  }
  
  .collect-btn .fab-icon {
    filter: invert(100%);
    opacity: 0.7;
  }
  
  .collect-btn.active .fab-icon {
    filter: invert(70%) sepia(80%) saturate(800%) hue-rotate(10deg) brightness(100%) contrast(100%);
    opacity: 1;
  }
}

/* Action Bar Icons */
.action-icon {
  width: 48rpx;
  height: 48rpx;
  /* 恢复标准 filter，确保 WebView 正常 */
  filter: grayscale(100%); 
}

@media (prefers-color-scheme: dark) {
  .action-icon {
    /* 深色模式下转为白色 */
    filter: invert(1);
  }
}

.action-item.active .action-icon {
  /* 激活状态（如已点赞） */
  filter: none; /* 显示原色（红色/蓝色） */
}

/* Comments Section */
.comments-section {
  margin-top: 40rpx;
  margin-left: -32rpx;
  margin-right: -32rpx;
  padding: 40rpx 32rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  border-top: 16rpx solid var(--active-bg);
}

.comments-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.comments-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.comments-sort {
  display: flex;
  align-items: center;
}

.sort-item {
  font-size: 26rpx;
  color: var(--text-sub);
}

.sort-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.sort-divider {
  width: 1px;
  height: 24rpx;
  background-color: var(--border-color);
  margin: 0 16rpx;
}

/* Comment Item */
.comment-item {
  display: flex;
  margin-bottom: 40rpx;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.comment-content-box {
  flex: 1;
}

.comment-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-right: 12rpx;
}

.author-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

.like-box {
  display: flex;
  align-items: center;
}

.like-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

.like-count {
  font-size: 24rpx;
  color: var(--text-sub);
}

.like-count.active {
  color: #ec4899; /* 点赞后的粉色 */
}

.comment-text {
  font-size: 30rpx;
  color: var(--text-main);
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.comment-footer {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.comment-time {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 24rpx;
}

.comment-actions {
  display: flex;
  align-items: center;
}

.action-reply {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 500;
  margin-right: 24rpx;
}

.action-delete {
  font-size: 26rpx;
  color: #ef4444;
  font-weight: 500;
}

/* Replies (楼中楼) */
.reply-box {
  background-color: var(--active-bg);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.reply-item {
  display: flex;
  margin-bottom: 20rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.reply-content {
  flex: 1;
}

.reply-top {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.reply-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-right: 8rpx;
}

.reply-tag {
  font-size: 18rpx;
  color: var(--tag-text);
  background-color: var(--tag-bg);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.reply-text {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.5;
  display: block;
  margin-bottom: 8rpx;
}

.reply-target {
  color: var(--text-main);
  font-weight: 500;
}

.reply-footer {
  display: flex;
  align-items: center;
}

.reply-time {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-right: 16rpx;
}

.reply-actions {
  display: flex;
  align-items: center;
}

.reply-actions .action-delete {
  font-size: 22rpx;
}

.reply-action {
  font-size: 24rpx;
  color: var(--text-sub);
}

.no-more-comments, .empty-comments {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-placeholder);
  font-size: 26rpx;
}

/* Input Modal */
.input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.2s;
}

.input-modal.show {
  visibility: visible;
  opacity: 1;
}

.input-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.4);
}

.input-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--card-bg);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.2s;
}

.input-modal.show .input-container {
  transform: translateY(0);
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--divider-color);
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.close-reply {
  font-size: 32rpx;
  padding: 0 20rpx;
  color: var(--text-sub);
}

.input-row {
  display: flex;
  align-items: flex-end;
}

.comment-input {
  flex: 1;
  background-color: var(--active-bg);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  line-height: 1.4;
  min-height: 80rpx;
  max-height: 240rpx;
  margin-right: 20rpx;
  color: var(--text-main);
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  background-color: var(--border-color);
  color: var(--text-sub);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.send-btn.active {
  background-color: var(--primary-color);
  color: #fff;
}

/* Back to Top - 文章页自定义样式 */
.back-to-top {
  position: fixed;
  right: 32rpx;
  bottom: calc(360rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  background-color: var(--card-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s ease;
  pointer-events: none;
  z-index: 100;
}

.back-to-top.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.back-to-top .arrow-up {
  width: 44rpx;
  height: 44rpx;
  filter: invert(48%) sepia(85%) saturate(1500%) hue-rotate(160deg) brightness(95%) contrast(95%);
}

@media (prefers-color-scheme: dark) {
  .back-to-top {
    background-color: var(--card-bg);
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  }
  
  .back-to-top .arrow-up {
    filter: invert(100%);
    opacity: 0.8;
  }
}

/* Parsed Content Styles */
.parsed-content {
  width: 100%;
}

.text-paragraph {
  margin-bottom: 24rpx;
  line-height: 1.8;
  font-size: 32rpx;
  color: var(--text-main);
  text-align: justify;
}

.article-link {
  color: #576b95; /* WeChat Link Blue */
  font-weight: 500;
  /* padding: 0 4rpx; // Padding on inline text might behave weirdly, better avoid or keep small */
}

.article-bold {
  font-weight: 700;
}

.article-img {
  width: 100%;
  height: auto;
  display: block;
  margin: 20rpx 0;
  border-radius: 8rpx;
}
