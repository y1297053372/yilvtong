.container {
  min-height: 100vh;
  background-color: var(--page-bg);
}

.results-area {
  padding: 16px;
}

.sort-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
  background-color: var(--active-bg);
  padding: 6px;
  border-radius: 12px;
  position: relative; /* For absolute positioning of indicator */
}

/* Sliding Indicator */
.active-indicator {
  position: absolute;
  top: 6px;
  bottom: 6px;
  left: 6px;
  width: calc((100% - 12px) / 3);
  background-color: var(--primary-color);
  border-radius: 8px;
  box-shadow: 0 4px 12px rgba(17, 82, 212, 0.25);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1; /* Behind text but above background */
}

/* Indicator Positions */
.pos-comprehensive { transform: translateX(0%); }
.pos-newest { transform: translateX(100%); }
.pos-most_viewed { transform: translateX(200%); }

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: var(--text-sub);
  padding: 8px 0;
  border-radius: 8px;
  transition: color 0.3s ease; /* Only animate text color */
  position: relative;
  z-index: 2; /* Above indicator */
}

.sort-item.active {
  background-color: transparent; /* Remove bg color */
  color: #ffffff;
  font-weight: 600;
  box-shadow: none; /* Remove shadow from item */
}

/* Card Style Results - Matching Index Style */
.article-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.limited-tip {
  background-color: var(--active-bg);
  padding: 12px 16px;
  border-radius: 8px;
  margin-bottom: 8px;
}

.limited-tip text {
  font-size: 12px;
  color: var(--text-sub);
  line-height: 1.5;
}

.article-card {
  background: var(--card-bg);
  border-radius: 16px;
  overflow: hidden; /* 确保图片圆角生效 */
  padding: 0; /* 移除内边距，让图片贴边 */
  border: none;
  box-shadow: var(--shadow-md); /* 增大阴影 */
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-bottom: 0; /* Remove old margin */
}

.article-image {
  width: 100%;
  height: 360rpx; /* 180px * 2 = 360rpx */
  display: block;
  background-color: var(--active-bg); /* Placeholder color */
}

.article-info {
  padding: 24rpx; /* 给文字区域添加内边距 */
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 2px;
}

.meta-tag {
  background-color: var(--tag-bg);
  color: var(--tag-text);
  font-size: 10px;
  font-weight: bold;
  padding: 2px 8px;
  border-radius: 16px;
}

.meta-date {
  font-size: 10px;
  color: var(--text-placeholder);
  font-weight: 500;
}

.article-title {
  font-size: 15px;
  font-weight: bold;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 0; /* Reset */
}

.article-summary {
  font-size: 12px;
  color: var(--text-sub);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Remove old styles that are no longer needed or conflict */
.card-header, .card-footer, .tag-box, .cat-tag, .stats, .stat-item {
  display: none;
}

/* Loading & Empty States */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px 0;
}

.loading-spinner {
  width: 30px;
  height: 30px;
  border: 3px solid var(--border-color);
  border-top: 3px solid var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.empty-tip {
  text-align: center;
  padding: 40px;
  color: var(--text-placeholder);
  font-size: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* Back To Top */
.back-to-top {
  position: fixed;
  bottom: 40px;
  right: 20px;
  width: 44px;
  height: 44px;
  background-color: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(17, 82, 212, 0.3);
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.3s ease;
  pointer-events: none;
  z-index: 90;
}

.back-to-top.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.arrow-up {
  width: 24px;
  height: 24px;
}