/* 浅色模式（默认） */
.privacy-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.privacy-content {
  position: relative;
  width: 86%;
  max-width: 680rpx;
  background-color: #fff;
  border-radius: 48rpx;
  padding: 48rpx 36rpx;
  box-sizing: border-box;
  transform: scale(0.9);
  transform-origin: center center;
}

.privacy-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-description {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.privacy-section {
  background-color: #f8f9fa;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c5ccf;
  margin-bottom: 20rpx;
}

.required-fields-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.required-field-item {
  width: 50%;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  filter: invert(45%) sepia(85%) saturate(2500%) hue-rotate(200deg) brightness(95%) contrast(90%);
}

.section-note {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8e8e8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.security-features {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.security-item {
  display: flex;
  align-items: flex-start;
}

.security-icon {
  width: 72rpx;
  height: 72rpx;
  background-color: #e8f0fe;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.security-icon image {
  width: 40rpx;
  height: 40rpx;
  filter: invert(45%) sepia(85%) saturate(2500%) hue-rotate(200deg) brightness(95%) contrast(90%);
}

.security-content {
  flex: 1;
}

.security-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.security-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.choice-note {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-top: 24rpx;
}

.privacy-checkbox {
  margin: 40rpx 0 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.checkbox-label {
  display: flex;
  align-items: center;
}

.checkbox-label checkbox {
  margin-right: 16rpx;
  transform: scale(0.9);
}

.privacy-checkbox .link {
  margin-left: 8rpx;
}

.link {
  color: #2c5ccf;
  text-decoration: none;
}

.privacy-buttons {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #5b7cff 0%, #4a6cf7 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(91, 124, 255, 0.3);
}

.btn-primary[disabled] {
  background: #c5c5c5;
  box-shadow: none;
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: transparent;
  color: #666;
  font-size: 30rpx;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  color: #333;
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  .privacy-mask {
    background-color: rgba(0, 0, 0, 0.7);
  }

  .privacy-content {
    background-color: #1a1a2e;
  }

  .privacy-title {
    color: #ffffff;
  }

  .privacy-description {
    color: #a0a0b0;
  }

  .privacy-section {
    background-color: #252538;
  }

  .section-title {
    color: #5b7cff;
  }

  .required-field-item {
    color: #e0e0e0;
  }

  .section-note {
    color: #808090;
    border-top-color: #3a3a4a;
  }

  .security-icon {
    background-color: #2a2a40;
  }

  .security-title {
    color: #ffffff;
  }

  .security-desc {
    color: #808090;
  }

  .choice-note {
    color: #a0a0b0;
  }

  .privacy-checkbox {
    color: #a0a0b0;
  }

  .link {
    color: #5b7cff;
  }

  .btn-primary {
    background: linear-gradient(135deg, #4a6cf7 0%, #3d5ce0 100%);
    box-shadow: 0 8rpx 24rpx rgba(74, 108, 247, 0.3);
  }

  .btn-primary[disabled] {
    background: #4a4a5a;
    color: #808090;
  }

  .btn-secondary {
    color: #a0a0b0;
  }

  .btn-secondary:active {
    color: #ffffff;
  }
}
